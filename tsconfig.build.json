{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "types": ["node"],
    "paths": {
      "@clapp/common": ["../common/src/public-api.ts"],
      "@clapp/core": ["../core/src/public-api.ts"],
      "@clapp/utils": ["../utils/src/public-api.ts"]
    }
  },
  "include": ["src/**/*.ts"]
}
